#!/bin/bash

set -u
umask 077

. /home/buet/cds_work/.cadence_mcp/lib/runner-common.sh

RUNNER_VERSION=0.15.0
WORKER="$CADENCE_MCP_ROOT/lib/run-smoke-job.sh"
PROFILE_WORKER="$CADENCE_MCP_ROOT/lib/run-profile-job.sh"
VIRTUOSO_BIN=/home/buet/cadence/IC615/tools/dfII/bin/virtuoso
SPECTRE_BIN=/home/buet/cadence/MMSIM121/tools/bin/spectre
OCEAN_BIN=/home/buet/cadence/IC615/tools/dfII/bin/ocean
DISCOVERY_HELPER="$CADENCE_MCP_ROOT/py26/discovery_json.py"
DISCOVERY_ALLOWLIST="$CADENCE_MCP_ROOT/config/discovery-allowlist.json"
DISCOVERY_RUNTIME="$CADENCE_MCP_ROOT/discovery-runtime"
PROFILE_HELPER="$CADENCE_MCP_ROOT/py26/profile_json.py"
FIXTURE_PROFILE="$CADENCE_MCP_ROOT/profiles/fixture-rc-transient/profile.json"
ACTUAL_PROFILE="$CADENCE_MCP_ROOT/profiles/actual-differential-amplifier-tb2-transient/profile.json"
WRITE_POLICY="$CADENCE_MCP_ROOT/config/design-write-policy.json"
WRITE_HELPER="$CADENCE_MCP_ROOT/py26/write_validation_json.py"
WRITE_WORKER="$CADENCE_MCP_ROOT/lib/run-design-write-validation.sh"
WRITE_PREFLIGHT="$CADENCE_MCP_ROOT/write/design-write-readonly-preflight.il"
V2_RECOVERY_WORKER="$CADENCE_MCP_ROOT/lib/run-design-write-v2-recovery.sh"
V3_PLAN="$CADENCE_MCP_ROOT/config/design-write-v3-plan.json"
V3_HELPER="$CADENCE_MCP_ROOT/py26/v3_validation_json.py"
V3_WORKER="$CADENCE_MCP_ROOT/lib/run-design-write-v3-validation.sh"
V3_FORENSIC_WORKER="$CADENCE_MCP_ROOT/lib/run-design-write-v3-forensic.sh"
V3_DEEP_FORENSIC_WORKER="$CADENCE_MCP_ROOT/lib/run-design-write-v3-deep-forensic.sh"
V3_EXACT_ROLLBACK_PLAN="$CADENCE_MCP_ROOT/config/design-write-v3-exact-conditional-rollback-plan.json"
V3_EXACT_ROLLBACK_HELPER="$CADENCE_MCP_ROOT/py26/v3_exact_rollback_json.py"
V3_EXACT_ROLLBACK_WORKER="$CADENCE_MCP_ROOT/lib/run-design-write-v3-exact-rollback.sh"

usage() {
    printf '%s\n' 'usage: cadence-runner version|health|submit-smoke|submit-profile|status|log-tail|result|cancel|list-libraries|list-cells|inspect-cellview|design-write-plan|design-write-preflight|design-write-validate|design-write-v2-forensic|design-write-v2-property-diff|design-write-v2-rollback|design-write-v3-plan-check|design-write-v3-validate|design-write-v3-property-diff|design-write-v3-deep-forensic|design-write-v3-exact-rollback|discovery-health|cleanup-dry-run|audit-tail' >&2
    exit 64
}

require_job() {
    cadence_mcp_validate_job_id "$1" || cadence_mcp_fail "invalid job id" 64
    job_dir=$(cadence_mcp_job_dir "$1") || cadence_mcp_fail "invalid job id" 64
    [ -d "$job_dir" ] || cadence_mcp_fail "job not found" 66
}

runner_version() {
    [ "$#" -eq 0 ] || usage
    printf '%s\n' "$RUNNER_VERSION"
}

runner_health() {
    [ "$#" -eq 0 ] || usage
    cadence_mcp_ensure_layout
    virtuoso_available=false
    spectre_available=false
    ocean_available=false
    [ -x "$VIRTUOSO_BIN" ] && virtuoso_available=true
    [ -x "$SPECTRE_BIN" ] && spectre_available=true
    [ -x "$OCEAN_BIN" ] && ocean_available=true
    virtuoso_version=$($VIRTUOSO_BIN -W 2>&1 | sed -n '/./{p;q;}' | cut -c1-200)
    spectre_version=$($SPECTRE_BIN -W 2>&1 | sed -n '/./{p;q;}' | cut -c1-200)
    license_state=UNSET
    [ -n "${CDS_LIC_FILE:-}" ] && license_state=SET
    "$CADENCE_MCP_PYTHON" "$CADENCE_MCP_JSON_HELPER" health \
        "$(hostname)" "$(id -un)" true \
        "$virtuoso_available" "$virtuoso_version" \
        "$spectre_available" "$spectre_version" \
        "$ocean_available" "$license_state" "$RUNNER_VERSION"
}

runner_submit_smoke() {
    [ "$#" -eq 2 ] || usage
    job_id=$1
    origin=$2
    cadence_mcp_validate_job_id "$job_id" || cadence_mcp_fail "invalid job id" 64
    case "$origin" in
        mcp) submitted_by=cadence-mcp-bridge ;;
        operator) submitted_by=$(id -un) ;;
        *) cadence_mcp_fail "invalid job origin" 64 ;;
    esac
    cadence_mcp_ensure_layout
    job_dir=$(cadence_mcp_job_dir "$job_id") || cadence_mcp_fail "invalid job id" 64
    [ ! -e "$job_dir" ] || cadence_mcp_fail "job already exists" 65
    mkdir -m 700 "$job_dir" || cadence_mcp_fail "cannot create job" 73
    : > "$job_dir/stdout.log"
    : > "$job_dir/stderr.log"
    chmod 600 "$job_dir/stdout.log" "$job_dir/stderr.log"
    submitted_at=$(cadence_mcp_utc_now)
    request_temporary="$job_dir/.request.$$.tmp"
    "$CADENCE_MCP_PYTHON" "$CADENCE_MCP_JSON_HELPER" request \
        "$job_id" "$CADENCE_MCP_PROFILE" "$submitted_at" "$origin" "$submitted_by" \
        > "$request_temporary" || cadence_mcp_fail "request serialization failed" 70
    chmod 600 "$request_temporary"
    mv -f "$request_temporary" "$job_dir/request.json"
    cadence_mcp_audit job_submitted "$job_id" "$origin" "$submitted_by" \
        || cadence_mcp_fail "audit write failed" 70
    cadence_mcp_atomic_status "$job_id" queued "job queued"
    queued_response=$(cat "$job_dir/status.json")
    nohup setsid "$WORKER" "$job_id" > /dev/null 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$job_dir/pid"
    printf '%s\n' "$pid" > "$job_dir/pgid"
    start_marker=$(ps -o lstart= -p "$pid" | sed 's/^ *//;s/ *$//')
    printf '%s\n' "$start_marker" > "$job_dir/start_marker"
    chmod 600 "$job_dir/pid" "$job_dir/pgid" "$job_dir/start_marker"
    printf '%s\n' "$queued_response"
}

runner_submit_profile() {
    [ "$#" -ge 4 ] || usage
    job_id=$1
    profile_id=$2
    corner=$3
    cadence_mcp_validate_job_id "$job_id" || cadence_mcp_fail "invalid job id" 64
    case "$profile_id" in
        fixture-rc-transient)
            [ "$#" -eq 7 ] || usage
            [ "$corner" = nominal ] || cadence_mcp_fail "corner is outside the profile" 64
            resistance=$4
            capacitance=$5
            stop_time=$6
            origin=$7
            number_pattern='^[0-9]+([.][0-9]*)?([eE][+-]?[0-9]+)?$'
            [[ "$resistance" =~ $number_pattern ]] || cadence_mcp_fail "invalid resistance" 64
            [[ "$capacitance" =~ $number_pattern ]] || cadence_mcp_fail "invalid capacitance" 64
            [[ "$stop_time" =~ $number_pattern ]] || cadence_mcp_fail "invalid stop time" 64
            "$CADENCE_MCP_PYTHON" "$PROFILE_HELPER" validate-fixture \
                "$FIXTURE_PROFILE" "$profile_id" "$corner" "$resistance" \
                "$capacitance" "$stop_time" \
                || cadence_mcp_fail "profile validation failed" 64
            ;;
        actual-differential-amplifier-tb2-transient)
            [ "$#" -eq 4 ] || usage
            [ "$corner" = NN ] || cadence_mcp_fail "corner is outside the profile" 64
            origin=$4
            "$CADENCE_MCP_PYTHON" "$PROFILE_HELPER" validate-actual \
                "$ACTUAL_PROFILE" "$profile_id" "$corner" \
                || cadence_mcp_fail "profile validation failed" 64
            ;;
        *) cadence_mcp_fail "profile is outside the registry" 64 ;;
    esac
    case "$origin" in
        mcp) submitted_by=cadence-mcp-bridge ;;
        operator) submitted_by=$(id -un) ;;
        *) cadence_mcp_fail "invalid job origin" 64 ;;
    esac
    cadence_mcp_ensure_layout
    job_dir=$(cadence_mcp_job_dir "$job_id") || cadence_mcp_fail "invalid job id" 64
    [ ! -e "$job_dir" ] || cadence_mcp_fail "job already exists" 65
    mkdir -m 700 "$job_dir" || cadence_mcp_fail "cannot create job" 73
    : > "$job_dir/stdout.log"
    : > "$job_dir/stderr.log"
    chmod 600 "$job_dir/stdout.log" "$job_dir/stderr.log"
    submitted_at=$(cadence_mcp_utc_now)
    case "$profile_id" in
        fixture-rc-transient)
            "$CADENCE_MCP_PYTHON" "$PROFILE_HELPER" prepare-fixture \
                "$FIXTURE_PROFILE" "$job_dir" "$job_id" "$profile_id" "$corner" \
                "$resistance" "$capacitance" "$stop_time" "$submitted_at" "$origin" \
                "$submitted_by" || cadence_mcp_fail "profile preparation failed" 64
            ;;
        actual-differential-amplifier-tb2-transient)
            "$CADENCE_MCP_PYTHON" "$PROFILE_HELPER" prepare-actual \
                "$ACTUAL_PROFILE" "$job_dir" "$job_id" "$profile_id" "$corner" \
                "$submitted_at" "$origin" "$submitted_by" \
                || cadence_mcp_fail "profile preparation failed" 64
            ;;
    esac
    cadence_mcp_audit job_submitted "$job_id" "$origin" "$submitted_by" \
        || cadence_mcp_fail "audit write failed" 70
    cadence_mcp_atomic_status "$job_id" queued "profile job queued"
    queued_response=$(cat "$job_dir/status.json")
    nohup setsid "$PROFILE_WORKER" "$job_id" > /dev/null 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$job_dir/pid"
    printf '%s\n' "$pid" > "$job_dir/pgid"
    start_marker=$(ps -o lstart= -p "$pid" | sed 's/^ *//;s/ *$//')
    printf '%s\n' "$start_marker" > "$job_dir/start_marker"
    chmod 600 "$job_dir/pid" "$job_dir/pgid" "$job_dir/start_marker"
    printf '%s\n' "$queued_response"
}

runner_status() {
    [ "$#" -eq 1 ] || usage
    require_job "$1"
    [ -f "$job_dir/status.json" ] || cadence_mcp_fail "job status unavailable" 69
    state=$($CADENCE_MCP_PYTHON "$CADENCE_MCP_JSON_HELPER" state "$job_dir/status.json")
    case "$state" in
        queued|running|cancelling)
            if [ -f "$job_dir/result.json" ]; then
                recovered_state=$($CADENCE_MCP_PYTHON "$CADENCE_MCP_JSON_HELPER" state "$job_dir/result.json")
                cadence_mcp_atomic_status "$1" "$recovered_state" "job state recovered from result"
            elif ! cadence_mcp_worker_matches "$job_dir"; then
                cadence_mcp_atomic_status "$1" unknown "job worker is unavailable; operator review required"
            fi
            ;;
    esac
    cat "$job_dir/status.json"
}

runner_log_tail() {
    [ "$#" -eq 3 ] || usage
    job_id=$1
    stream=$2
    lines=$3
    require_job "$job_id"
    case "$stream" in
        stdout|stderr) ;;
        *) cadence_mcp_fail "invalid log stream" 64 ;;
    esac
    [[ "$lines" =~ ^[1-9][0-9]{0,2}$ ]] || cadence_mcp_fail "invalid line count" 64
    [ "$lines" -le 200 ] || cadence_mcp_fail "line count exceeds 200" 64
    "$CADENCE_MCP_PYTHON" "$CADENCE_MCP_JSON_HELPER" log-tail \
        "$job_dir/$stream.log" "$job_id" "$stream" "$lines"
}

runner_result() {
    [ "$#" -eq 1 ] || usage
    require_job "$1"
    [ -f "$job_dir/result.json" ] || cadence_mcp_fail "job result not ready" 69
    cat "$job_dir/result.json"
}

runner_cancel() {
    [ "$#" -eq 1 ] || usage
    job_id=$1
    require_job "$job_id"
    state=$($CADENCE_MCP_PYTHON "$CADENCE_MCP_JSON_HELPER" state "$job_dir/status.json")
    case "$state" in
        succeeded|failed|cancelled)
            cat "$job_dir/status.json"
            return 0
            ;;
    esac
    [ -f "$job_dir/pid" ] || cadence_mcp_fail "job pid unavailable" 69
    [ -f "$job_dir/pgid" ] || cadence_mcp_fail "job process group unavailable" 69
    [ -f "$job_dir/start_marker" ] || cadence_mcp_fail "job start marker unavailable" 69
    pid=$(cat "$job_dir/pid")
    pgid=$(cat "$job_dir/pgid")
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || cadence_mcp_fail "invalid stored pid" 70
    [[ "$pgid" =~ ^[1-9][0-9]*$ ]] || cadence_mcp_fail "invalid stored process group" 70
    [ "$pid" = "$pgid" ] || cadence_mcp_fail "process group ownership mismatch" 70
    kill -0 "$pid" 2>/dev/null || cadence_mcp_fail "job process is not running" 69
    current_pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
    [ "$current_pgid" = "$pgid" ] || cadence_mcp_fail "process group changed" 70
    stored_marker=$(cat "$job_dir/start_marker")
    current_marker=$(ps -o lstart= -p "$pid" | sed 's/^ *//;s/ *$//')
    [ -n "$stored_marker" ] && [ "$stored_marker" = "$current_marker" ] \
        || cadence_mcp_fail "process identity changed" 70
    : > "$job_dir/cancel.request"
    chmod 600 "$job_dir/cancel.request"
    cadence_mcp_atomic_status "$job_id" cancelling "cancellation requested"
    origin=$(cadence_mcp_job_origin "$job_dir")
    case "$origin" in
        mcp) actor=cadence-mcp-bridge ;;
        operator) actor=$(id -un) ;;
        *) cadence_mcp_fail "invalid stored job origin" 70 ;;
    esac
    cadence_mcp_audit cancellation_requested "$job_id" "$origin" "$actor" \
        || cadence_mcp_fail "audit write failed" 70
    kill -TERM -- "-$pgid" || cadence_mcp_fail "cancellation signal failed" 70
    cat "$job_dir/status.json"
}

runner_list_libraries() {
    [ "$#" -eq 0 ] || usage
    "$CADENCE_MCP_PYTHON" "$DISCOVERY_HELPER" "$DISCOVERY_ALLOWLIST" list-libraries
}

runner_list_cells() {
    [ "$#" -eq 1 ] || usage
    "$CADENCE_MCP_PYTHON" "$DISCOVERY_HELPER" "$DISCOVERY_ALLOWLIST" list-cells "$1"
}

runner_inspect_cellview() {
    [ "$#" -eq 3 ] || usage
    "$CADENCE_MCP_PYTHON" "$DISCOVERY_HELPER" "$DISCOVERY_ALLOWLIST" \
        inspect-cellview "$1" "$2" "$3"
}

runner_discovery_health() {
    [ "$#" -eq 0 ] || usage
    [ -x "$OCEAN_BIN" ] || cadence_mcp_fail "OCEAN is unavailable" 69
    [ -x "$VIRTUOSO_BIN" ] || cadence_mcp_fail "Virtuoso is unavailable" 69
    mkdir -p "$DISCOVERY_RUNTIME" || cadence_mcp_fail "cannot create discovery runtime" 73
    chmod 700 "$DISCOVERY_RUNTIME"
    (
        cd "$DISCOVERY_RUNTIME" || exit 73
        timeout 60 "$OCEAN_BIN" -nograph -nocdsinit \
            -restore "$CADENCE_MCP_ROOT/discovery/ocean-smoke.ocn" \
            -log "$DISCOVERY_RUNTIME/ocean.log" \
            > "$DISCOVERY_RUNTIME/ocean.stdout" 2> "$DISCOVERY_RUNTIME/ocean.stderr"
    ) || cadence_mcp_fail "OCEAN headless smoke failed" 69
    grep -q 'CADENCE_MCP_OCEAN_HEADLESS_OK' \
        "$DISCOVERY_RUNTIME/ocean.log" "$DISCOVERY_RUNTIME/ocean.stdout" \
        || cadence_mcp_fail "OCEAN headless marker missing" 69
    (
        cd "$DISCOVERY_RUNTIME" || exit 73
        timeout 60 "$VIRTUOSO_BIN" -nograph -nocdsinit \
            -restore "$CADENCE_MCP_ROOT/discovery/skill-smoke.il" \
            -log "$DISCOVERY_RUNTIME/skill.log" \
            > "$DISCOVERY_RUNTIME/skill.stdout" 2> "$DISCOVERY_RUNTIME/skill.stderr"
    ) || cadence_mcp_fail "SKILL headless smoke failed" 69
    grep -q 'CADENCE_MCP_SKILL_HEADLESS_OK' \
        "$DISCOVERY_RUNTIME/skill.log" "$DISCOVERY_RUNTIME/skill.stdout" \
        || cadence_mcp_fail "SKILL headless marker missing" 69
    printf '%s\n' '{"isolated_runtime":true,"ocean_headless":true,"skill_headless":true}'
}

runner_design_write_plan() {
    [ "$#" -eq 0 ] || usage
    "$CADENCE_MCP_PYTHON" "$WRITE_HELPER" "$WRITE_POLICY" plan
}

runner_design_write_preflight() {
    [ "$#" -eq 0 ] || usage
    [ -x "$VIRTUOSO_BIN" ] || cadence_mcp_fail "Virtuoso is unavailable" 69
    "$CADENCE_MCP_PYTHON" "$WRITE_HELPER" "$WRITE_POLICY" source-check \
        || cadence_mcp_fail "source master or artifact check failed" 65
    runtime="$CADENCE_MCP_ROOT/write-validation/preflight"
    mkdir -p "$runtime" || cadence_mcp_fail "preflight runtime creation failed" 73
    chmod 700 "$runtime"
    (
        cd /home/buet/cds_work || exit 73
        timeout 60 "$VIRTUOSO_BIN" -nograph -nocdsinit -restore "$WRITE_PREFLIGHT" \
            -log "$runtime/skill.log" > "$runtime/skill.stdout" 2> "$runtime/skill.stderr"
    ) || cadence_mcp_fail "fixed write preflight failed" 69
    grep -q '^MCP_WRITE_PREFLIGHT|true|' "$runtime/skill.stdout" \
        || cadence_mcp_fail "write preflight marker missing" 69
    grep '^MCP_WRITE_PREFLIGHT|true|' "$runtime/skill.stdout" | tail -n 1
}

runner_design_write_validate() {
    [ "$#" -eq 3 ] || usage
    validation_id=$1
    confirmation=$2
    origin=$3
    cadence_mcp_validate_job_id "$validation_id" || cadence_mcp_fail "invalid validation id" 64
    case "$origin" in mcp|operator) ;; *) cadence_mcp_fail "invalid validation origin" 64 ;; esac
    "$CADENCE_MCP_PYTHON" "$WRITE_HELPER" "$WRITE_POLICY" confirm "$confirmation" \
        || cadence_mcp_fail "write confirmation rejected" 64
    "$WRITE_WORKER" "$validation_id" "$origin"
}

runner_design_write_v2_forensic() {
    [ "$#" -eq 0 ] || usage
    "$V2_RECOVERY_WORKER" forensic
}

runner_design_write_v2_property_diff() {
    [ "$#" -eq 0 ] || usage
    "$V2_RECOVERY_WORKER" property-diff
}

runner_design_write_v2_rollback() {
    [ "$#" -eq 1 ] || usage
    [ "$1" = "APPROVE_MCP_V2_BACKUP_ROLLBACK" ] \
        || cadence_mcp_fail "V2 rollback confirmation rejected" 64
    "$V2_RECOVERY_WORKER" rollback
}

runner_design_write_v3_plan_check() {
    [ "$#" -eq 0 ] || usage
    "$CADENCE_MCP_PYTHON" "$V3_HELPER" "$V3_PLAN" plan-check
}

runner_design_write_v3_validate() {
    [ "$#" -eq 3 ] || usage
    validation_id=$1
    confirmation=$2
    origin=$3
    cadence_mcp_validate_job_id "$validation_id" || cadence_mcp_fail "invalid V3 validation id" 64
    case "$origin" in mcp|operator) ;; *) cadence_mcp_fail "invalid V3 validation origin" 64 ;; esac
    "$CADENCE_MCP_PYTHON" "$V3_HELPER" "$V3_PLAN" confirm "$confirmation" \
        || cadence_mcp_fail "V3 confirmation rejected" 64
    "$V3_WORKER" "$validation_id" "$origin"
}

runner_design_write_v3_property_diff() {
    [ "$#" -eq 0 ] || usage
    "$V3_FORENSIC_WORKER"
}

runner_design_write_v3_deep_forensic() {
    [ "$#" -eq 0 ] || usage
    "$V3_DEEP_FORENSIC_WORKER"
}

runner_design_write_v3_exact_rollback() {
    [ "$#" -eq 3 ] || usage
    run_id=$1
    confirmation=$2
    origin=$3
    cadence_mcp_validate_job_id "$run_id" || cadence_mcp_fail "invalid rollback run id" 64
    [ "$origin" = "operator" ] || cadence_mcp_fail "invalid rollback origin" 64
    "$CADENCE_MCP_PYTHON" "$V3_EXACT_ROLLBACK_HELPER" "$V3_EXACT_ROLLBACK_PLAN" \
        confirm "$confirmation" || cadence_mcp_fail "exact rollback confirmation rejected" 64
    "$V3_EXACT_ROLLBACK_WORKER" "$run_id" "$origin"
}

runner_cleanup_dry_run() {
    [ "$#" -eq 0 ] || usage
    cadence_mcp_ensure_layout
    "$CADENCE_MCP_PYTHON" "$CADENCE_MCP_JSON_HELPER" retention \
        "$CADENCE_MCP_JOBS_ROOT" 30 "$(cadence_mcp_utc_now)"
}

runner_audit_tail() {
    [ "$#" -eq 0 ] || usage
    cadence_mcp_ensure_layout
    [ -f "$CADENCE_MCP_AUDIT_LOG" ] || return 0
    tail -n 100 "$CADENCE_MCP_AUDIT_LOG" | tail -c 65536
}

[ "$#" -ge 1 ] || usage
command_name=$1
shift
case "$command_name" in
    version) runner_version "$@" ;;
    health) runner_health "$@" ;;
    submit-smoke) runner_submit_smoke "$@" ;;
    submit-profile) runner_submit_profile "$@" ;;
    status) runner_status "$@" ;;
    log-tail) runner_log_tail "$@" ;;
    result) runner_result "$@" ;;
    cancel) runner_cancel "$@" ;;
    list-libraries) runner_list_libraries "$@" ;;
    list-cells) runner_list_cells "$@" ;;
    inspect-cellview) runner_inspect_cellview "$@" ;;
    design-write-plan) runner_design_write_plan "$@" ;;
    design-write-preflight) runner_design_write_preflight "$@" ;;
    design-write-validate) runner_design_write_validate "$@" ;;
    design-write-v2-forensic) runner_design_write_v2_forensic "$@" ;;
    design-write-v2-property-diff) runner_design_write_v2_property_diff "$@" ;;
    design-write-v2-rollback) runner_design_write_v2_rollback "$@" ;;
    design-write-v3-plan-check) runner_design_write_v3_plan_check "$@" ;;
    design-write-v3-validate) runner_design_write_v3_validate "$@" ;;
    design-write-v3-property-diff) runner_design_write_v3_property_diff "$@" ;;
    design-write-v3-deep-forensic) runner_design_write_v3_deep_forensic "$@" ;;
    design-write-v3-exact-rollback) runner_design_write_v3_exact_rollback "$@" ;;
    discovery-health) runner_discovery_health "$@" ;;
    cleanup-dry-run) runner_cleanup_dry_run "$@" ;;
    audit-tail) runner_audit_tail "$@" ;;
    *) usage ;;
esac
